# Copy to .env and fill in your key. .env is in .gitignore - never commit it.
# Without a key TAKT still runs: it replays the saved GPT-5 answers and uses rule-based fallbacks.
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5
AZURE_OPENAI_REASONING=low
